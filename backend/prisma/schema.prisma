generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  avatar       String         @default("👤")
  color        String         @default("bg-blue-100 text-blue-700")
  skills       String[]       @default([])
  aiPrompt     String?
  // 用户自定义AI模型配置
  aiProvider   String?        // gemini | openai | deepseek | moonshot | zhipu | custom
  aiApiKey     String?        // 用户的API Key (加密存储)
  aiBaseUrl    String?        // 自定义Base URL (OpenAI兼容格式)
  aiModelName  String?        // 自定义模型名称
  isFirstLogin Boolean        @default(true)
  isSuperAdmin Boolean        @default(false)
  isActive     Boolean        @default(true)
  currentTeamId String?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  tasks        Task[]         @relation("TaskAssignee")
  subtasks     Subtask[]      @relation("SubtaskAssignee")
  teamMembers  TeamMember[]
  ownedTeams   Team[]         @relation("TeamOwner")
  loginLogs    LoginLog[]
  notifications Notification[]
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([userId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  inviteLink  String       @unique
  ownerId     String
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members     TeamMember[]
  tasks       Task[]
  createdAt   DateTime     @default(now())
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  @@unique([userId, teamId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  dueDate     DateTime?
  dependsOn   String[]  @default([])
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([teamId, isArchived])
}

model Subtask {
  id         String  @id @default(cuid())
  title      String
  completed  Boolean @default(false)
  taskId     String
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, read])
}
