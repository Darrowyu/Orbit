generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  name         String
  avatar       String         @default("👤")
  color        String         @default("bg-blue-100 text-blue-700")
  skills       String[]       @default([])
  aiPrompt     String?
  aiProvider   String?
  aiApiKey     String?
  aiBaseUrl    String?
  aiModelName  String?
  isFirstLogin Boolean        @default(true)
  isSuperAdmin Boolean        @default(false)
  isActive     Boolean        @default(true)
  currentTeamId String?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  tasks          Task[]          @relation("TaskAssignee")
  subtasks       Subtask[]       @relation("SubtaskAssignee")
  teamMembers    TeamMember[]
  ownedTeams     Team[]          @relation("TeamOwner")
  ownedProjects  Project[]       @relation("ProjectOwner")
  projectMembers ProjectMember[]
  loginLogs      LoginLog[]
  notifications  Notification[]
  notificationPreference NotificationPreference?
  comments       Comment[]
  auditLogs      AuditLog[]
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  @@index([userId])
}

model Team {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  inviteLink  String       @unique
  ownerId     String
  owner       User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members     TeamMember[]
  projects    Project[]
  tasks       Task[]
  createdAt   DateTime     @default(now())
}

model Project {
  id          String          @id @default(cuid())
  name        String
  description String          @default("")
  color       String          @default("#6366f1")
  status      String          @default("ACTIVE") // ACTIVE, ON_HOLD, COMPLETED, ARCHIVED
  startDate   DateTime?
  endDate     DateTime?
  teamId      String
  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  tasks       Task[]          @relation("ProjectTasks")
  isArchived  Boolean         @default(false)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([teamId, isArchived])
  @@index([ownerId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String   @default("member") // owner, admin, member
  joinedAt  DateTime @default(now())
  @@unique([userId, projectId])
}

model TeamMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  joinedAt  DateTime @default(now())
  @@unique([userId, teamId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  status      String    @default("TODO")
  priority    String    @default("MEDIUM")
  assigneeId  String?
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?  @relation("ProjectTasks", fields: [projectId], references: [id], onDelete: SetNull)
  teamId      String
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  comments    Comment[]
  dueDate     DateTime?
  dependsOn   String[]  @default([])
  isArchived  Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([teamId, isArchived])
  @@index([projectId])
}

model Subtask {
  id         String  @id @default(cuid())
  title      String
  completed  Boolean @default(false)
  taskId     String
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("SubtaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([userId, read])
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssigned        Boolean @default(true)
  taskStatusChanged   Boolean @default(true)
  taskDueSoon         Boolean @default(true)
  taskOverdue         Boolean @default(true)
  newComment          Boolean @default(true)
  projectMemberAdded  Boolean @default(true)
  teamJoined          Boolean @default(true)
  browserPush         Boolean @default(true)
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([taskId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // CREATE, UPDATE, DELETE, ARCHIVE, RESTORE, MOVE, ASSIGN
  entityType String   // TASK, SUBTASK, TEAM, USER
  entityId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId     String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())
  @@index([teamId, createdAt])
  @@index([entityType, entityId])
}
