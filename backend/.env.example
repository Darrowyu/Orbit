# 数据库连接
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/orbit?schema=public"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 加密密钥（用于加密用户敏感数据如 API Key，不设置则使用 JWT_SECRET）
# ENCRYPTION_KEY="your-encryption-key-change-in-production"

# 服务端口
PORT=4000

# 前端地址（CORS配置）
FRONTEND_URL="http://localhost:1234"

# AI Configuration (Anthropic Messages API 格式，支持 Kimi 等兼容服务)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.kimi.com/coding/
AI_MODEL=kimi-k2.5
# HTTPS_PROXY=http://127.0.0.1:7890 # 需要代理时开启

# 登录安全配置
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
