# 数据库连接
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/orbit?schema=public"

# JWT 配置（必填：至少 32 字符高熵随机密钥，应用会拒绝使用默认值启动）
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# 加密密钥（AES-256-GCM，用于加密用户级 AI API Key 等敏感数据；不设置则用户无法保存 AI Key）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY="your-encryption-key-64-hex-chars"

# 服务端口
PORT=4000

# 前端地址（CORS配置）
FRONTEND_URL="http://localhost:1234"

# AI Configuration (Anthropic Messages API 格式，支持 Kimi 等兼容服务)
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.kimi.com/coding/
AI_MODEL=kimi-k2.5
# HTTPS_PROXY=http://127.0.0.1:7890 # 需要代理时开启

# 全局限流配置（RateLimitMiddleware，对所有请求按 IP 或登录用户分桶计数）
# 注意：登录失败锁定（同邮箱 15 分钟内 5 次、同 IP 20 次）在 AuthService 内硬编码，不由此处配置
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# SMTP 邮件配置（忘记密码验证码等；不配置则降级为服务端日志输出，开发环境可用）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM="Orbit <noreply@example.com>"
