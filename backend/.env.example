# 数据库连接
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/orbit?schema=public"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# 加密密钥（用于加密用户敏感数据如 API Key，不设置则使用 JWT_SECRET）
# ENCRYPTION_KEY="your-encryption-key-change-in-production"

# Gemini AI API
GEMINI_API_KEY="your-gemini-api-key"

# 服务端口
PORT=4000

# 前端地址（CORS配置）
FRONTEND_URL="http://localhost:1234"

# AI Configuration (Primary - Gemini)
GEMINI_API_KEY=your_gemini_key_here
# HTTPS_PROXY=http://127.0.0.1:7890 # 仅 Gemini 需要代理时开启

# AI Configuration (Backup - OpenAI Compatible: DeepSeek/Kimi/Yi)
# 当 Gemini 失败时，自动切换到此通道
AI_PROVIDER_BACKUP=deepseek # deepseek | openai | moonshot
AI_API_KEY_BACKUP=sk-xxxxxxx
AI_BASE_URL_BACKUP=https://api.deepseek.com/v1 # 兼容 OpenAI 格式的 Base URL

# 登录安全配置
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
